# Normalisasi line ending: repo memakai LF di semua platform.
* text=auto eol=lf

*.c        text
*.h        text
*.cpp      text
*.hpp      text
*.sh       text eol=lf
*.service  text eol=lf
*.yml      text eol=lf
*.yaml     text eol=lf
Makefile   text eol=lf

# Screenshot & artefak biner
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary

# Dependensi pihak ketiga tidak dihitung sebagai bahasa repo.
external/** linguist-vendored
