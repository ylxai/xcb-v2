# Salin ke ~/.config/xcb/watch.env lalu isi channel alert.
# Pilih salah satu atau keduanya.

# Slack / Discord / webhook generik (menerima JSON {"text": "..."})
# ALERT_WEBHOOK="https://hooks.slack.com/services/XXX/YYY/ZZZ"

# Telegram
# ALERT_TELEGRAM_TOKEN="123456:ABC-DEF..."
# ALERT_TELEGRAM_CHAT="123456789"

# Ambang batas
# MIN_HR=400
# MAX_REJECT_PCT=5
# RECONNECT_LIMIT=3
# ALERT_COOLDOWN=1800
