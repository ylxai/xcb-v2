# Salin ke ~/.config/xcb/watch.env lalu isi channel alert.
# Pilih salah satu atau keduanya.

# Webhook generik: Discord memakai "content", Slack memakai "text";
# skrip mengirim kedua field.
# ALERT_WEBHOOK="https://discord.com/api/webhooks/.../..."

# Telegram
# ALERT_TELEGRAM_TOKEN="123456:ABC-DEF..."
# ALERT_TELEGRAM_CHAT="123456789"

# Ambang batas
# MIN_HR=400
# MAX_REJECT_PCT=5
# REJECT_MIN_DELTA=20
# RECONNECT_LIMIT=3
# ALERT_COOLDOWN=1800
