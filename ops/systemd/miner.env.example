# Salin ke /etc/xcb/miner.env lalu: sudo chmod 600 /etc/xcb/miner.env
# Jangan commit file hasil salinan ini (berisi wallet).
#
# WALLET wajib diisi. Placeholder di bawah akan ditolak unit saat start.

CONN_POOL=eu.rplant.xyz:17194
WALLET=ISI_WALLET_CONN
WORKER=CHANGE_ME
THREADS=4
# Opsional. Beberapa host solo ke node yang sama harus memakai offset berbeda
# supaya rentang nonce tidak tumpang tindih (0..4294967295, default 0).
# CONN_NONCE_OFFSET=0
