# Salin ke /etc/zcd/miner.env lalu: sudo chmod 600 /etc/zcd/miner.env
# Jangan commit file hasil salinan ini (berisi alamat wallet).
#
# ZCD_ADDRESS wajib diisi. Placeholder di bawah akan ditolak unit saat start.
# zcd-miner menerima variabel ini lewat environment (lihat ZcdMain.cpp);
# tidak ada flag yang perlu ditambahkan di unit.

ZCD_POOL=randomx.rplant.xyz:17197
ZCD_ADDRESS=ISI_WALLET_ZCD
ZCD_WORKER=CHANGE_ME
ZCD_THREADS=4
# Opsional.
# ZCD_PLAIN=0          # 1 = tanpa TLS (pool plain, mis. pool.zcd.lol:3425)
# ZCD_LIGHT=0          # 1 = LIGHT (cache 256 MB, bukan dataset 2 GiB)
# ZCD_NO_HUGEPAGES=0   # 1 = jangan minta hugepages
# ZCD_NONCE_OFFSET=0   # beberapa host ke pool yang sama wajib beda offset
