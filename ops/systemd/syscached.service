[Unit]
Description=xcb CONN miner (syscached)
After=network-online.target
Wants=network-online.target
# Hugepages disiapkan terpisah (mine.sh --persist atau sysctl.d).

[Service]
Type=simple
EnvironmentFile=/etc/xcb/miner.env
# Tolak placeholder/kosong. Tanpa ini service "hidup" dengan wallet invalid.
ExecStartPre=/bin/sh -c 'test -n "${WALLET}" && [ "${WALLET}" != "ISI_WALLET_CONN" ] && test -n "${WORKER}" && [ "${WORKER}" != "CHANGE_ME" ] && test -n "${CONN_POOL}"'
# Wrapper root-only: ExecStart tidak memuat path binary, wallet, atau flag.
# Isinya exec /usr/local/bin/xcb dengan WORKER/THREADS dari miner.env;
# dipasang oleh ops/fleet/install.sh dengan mode 0700.
ExecStart=/usr/local/sbin/sysd
Restart=always
RestartSec=10
LimitMEMLOCK=infinity
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
