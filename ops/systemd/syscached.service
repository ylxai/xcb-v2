[Unit]
Description=xcb CONN miner (syscached)
After=network-online.target
Wants=network-online.target
# Hugepages disiapkan terpisah (mine.sh --persist atau sysctl.d).

[Service]
Type=simple
EnvironmentFile=/etc/xcb/miner.env
# Tolak placeholder/kosong. Tanpa ini service "hidup" dengan wallet invalid.
ExecStartPre=/bin/sh -c 'test -n "${WALLET}" && [ "${WALLET}" != "ISI_WALLET_CONN" ] && test -n "${WORKER}" && [ "${WORKER}" != "CHANGE_ME" ] && test -n "${CONN_POOL}"'
# Flag -u/--worker/-t eksplisit agar unit tetap benar di binary lama yang
# belum membaca WALLET/WORKER/THREADS dari env pada jalur CONN. Di binary baru
# flag tetap menang sebagai CLI: -u harus memakai alamat reward yang sama
# dengan CONN_ADDRESS/WALLET. Kalau CONN_ADDRESS diisi berbeda, hapus -u.
ExecStart=/usr/local/bin/xcb -a conn --conn-pool ${CONN_POOL} -u ${WALLET} --worker ${WORKER} -t ${THREADS} --ui=log
Restart=always
RestartSec=10
LimitMEMLOCK=infinity
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
